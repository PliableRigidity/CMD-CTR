# Tool integrations
OPENWEATHER_API_KEY=your_key_here
SEARXNG_URL=http://localhost:8888
TIMEZONE=Asia/Kolkata

# Voice
WHISPER_MODEL_SIZE=base
PIPER_MODEL_PATH=C:/Piper/models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=
PIPER_USE_CUDA=false

# Memory router mode: ""(auto, backward compatible) | brain63 | kosine | hybrid
MEMORY_MODE=

# KOSINE — structured memory backend (Phase 19). All default OFF for a gradual,
# reversible migration. The COMPLIANT transport is REST: run KOSINE as its own
# service (`python server.py` in the KOS repo → 127.0.0.1:8000) and SILVIA talks
# to it over HTTP only (no `import kos`, no direct DB access). Recommended rollout
# order: start KOSINE service → enable → make primary → allow writes → maintenance.
KOSINE_ENABLED=false                 # register the KOSINE memory provider
KOSINE_PRIMARY=false                 # promote KOSINE to first read priority (Brain63 → fallback)
KOSINE_TRANSPORT=rest                # 'rest' (compliant, default) or 'local' (legacy in-process SDK; migration only)
KOSINE_BASE_URL=http://127.0.0.1:8000  # KOSINE REST service URL (compliant transport)
KOSINE_TIMEOUT_SECONDS=15            # per-request HTTP timeout
KOSINE_MAX_RETRIES=2                 # bounded retries (exp. backoff) on transient failures
KOSINE_API_TOKEN=                    # optional Bearer token if KOSINE auth is enabled
KOSINE_ALLOW_WRITES=false            # permit SILVIA-originated create/update (audited)
KOSINE_MAINTENANCE_AUTODRAFT=false   # let the maintenance loop draft suggestion workflows
# Migration runs via KOSINE's own CLI (spec-compliant subprocess):
KOSINE_CLI=                          # blank = auto (kosine on PATH, else python <repo>/kos.py)
KOSINE_REPO_PATH=C:/Users/IshaanV/Documents/GitHub/KOS   # KOSINE checkout (CLI/DB resolution)
KOSINE_DB_PATH=                      # blank = <KOSINE_REPO_PATH>/kosine.db
